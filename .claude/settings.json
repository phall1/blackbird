{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "GOTOOLCHAIN": "go1.26.5"
  },
  "enabledMcpjsonServers": [
    "blackbird"
  ],
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go run:*)",
      "Bash(go list:*)",
      "Bash(go mod:*)",
      "Bash(go tool:*)",
      "Bash(gofmt:*)",
      "Bash(golangci-lint:*)",
      "Bash(make:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(node --test:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/go-edit-gate.sh\"",
            "timeout": 60,
            "statusMessage": "Checking Go format, boundaries, build"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/node-edit-gate.sh\"",
            "timeout": 90,
            "statusMessage": "Type-checking plugin package"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-start.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
