{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": [
    "blackbird"
  ],
  "env": {
    "GOTOOLCHAIN": "go1.26.6"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go run:*)",
      "Bash(go list:*)",
      "Bash(go doc:*)",
      "Bash(go mod:*)",
      "Bash(gofmt:*)",
      "Bash(make:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(jq:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm ci:*)",
      "Bash(npm run:*)",
      "Bash(node --test:*)"
    ]
  }
}
